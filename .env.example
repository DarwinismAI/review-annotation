# Copy to .env.local and fill in. NEVER commit .env.local.

# ── Supabase (auth + Postgres) ───────────────────────────────────────────────
# Project dashboard → Settings → API
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-exposed copies (Next.js requires NEXT_PUBLIC_ prefix to ship to client).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare D1 (production) ───────────────────────────────────────────────
# Leave these unset in local dev - the app falls back to better-sqlite3.
# Create a scoped API token at: https://dash.cloudflare.com/profile/api-tokens
#   Permissions needed: Account > D1 > Edit
CLOUDFLARE_ACCOUNT_ID=e19cb3732b64ffcb7128e257ad976b09
CLOUDFLARE_D1_DATABASE_ID=682ba3a4-1713-4e51-b894-39523ef6bbf0
CLOUDFLARE_D1_TOKEN=

# ── Local dev SQLite ─────────────────────────────────────────────────────────
# Overrides the default ./local.db path (optional).
# LOCAL_DB_PATH=./local.db

# ── Cloudflare R2 (file uploads - TODO) ──────────────────────────────────────
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# OAuth providers (uncomment per PRD)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# App base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email OTP ────────────────────────────────────────────────────────────────
# Supabase Auth gửi OTP email qua built-in service (free tier ~4 mail/h).
# Nâng rate limit: dashboard → Authentication → SMTP Settings → bật custom SMTP.
